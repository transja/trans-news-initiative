add_track_artist_genres_cached <- function(df,
cache_var = "track_genre_cache",
save_path = NULL) {
# Where to store the cache (global env by default)
env <- .GlobalEnv
# 1. Initialize cache if it doesn't exist
if (!exists(cache_var, envir = env)) {
assign(
cache_var,
tibble(
spotify_track_uri = character(),
artist_genres     = list()
),
envir = env
)
}
cache <- get(cache_var, envir = env)
# 2. Unique track URIs in this df
track_uris <- df %>%
distinct(spotify_track_uri) %>%
filter(!is.na(spotify_track_uri)) %>%
pull()
if (length(track_uris) == 0) {
warning("No spotify_track_uri values found.")
return(df %>% mutate(artist_genres = NA))
}
# 3. Which URIs still need to be fetched?
to_fetch <- setdiff(track_uris, cache$spotify_track_uri)
message("Total unique tracks: ", length(track_uris))
message("Already in cache:    ", length(track_uris) - length(to_fetch))
message("To fetch now:        ", length(to_fetch))
# 4. Loop over tracks to fetch and update cache as we go
for (i in seq_along(to_fetch)) {
uri <- to_fetch[i]
track_id <- gsub("^spotify:track:", "", uri)
message("Fetching ", i, "/", length(to_fetch), ": ", uri)
# get_track can fail → protect with tryCatch
track <- tryCatch(
get_track(track_id),
error = function(e) {
message("  get_track error: ", conditionMessage(e))
NULL
}
)
if (is.null(track)) {
genres_vec <- NA_character_
} else {
# Extract artist IDs from the track object
artist_ids <- tryCatch(
{
# track$artists is a list of artist lists
vapply(track$artists, function(a) a$id, character(1))
},
error = function(e) character(0)
)
if (length(artist_ids) == 0) {
genres_vec <- NA_character_
} else {
# Get all artists for this track
artists <- tryCatch(
get_artists(artist_ids),
error = function(e) {
message("  get_artists error: ", conditionMessage(e))
NULL
}
)
if (is.null(artists) || nrow(artists) == 0) {
genres_vec <- NA_character_
} else {
# Combine all artists' genres for this track
genres_vec <- unique(unlist(artists$genres))
if (length(genres_vec) == 0) {
genres_vec <- NA_character_
}
}
}
}
# One-row tibble for this track
new_row <- tibble(
spotify_track_uri = uri,
artist_genres     = list(genres_vec)
)
# Update cache *incrementally*
cache <- bind_rows(cache, new_row)
assign(cache_var, cache, envir = env)
# Optionally save to disk each iteration
if (!is.null(save_path)) {
saveRDS(cache, save_path)
}
}
# 5. Join final cache back to df
cache <- get(cache_var, envir = env)
df %>%
left_join(cache, by = "spotify_track_uri")
}
# First run (creates and fills cache)
df_with_genres <- add_track_artist_genres_cached(
df,
cache_var = "track_genre_cache",
save_path = "track_genre_cache.rds"  # optional
)
# If it crashes halfway, just run again:
df_with_genres <- add_track_artist_genres_cached(
df,
cache_var = "track_genre_cache",
save_path = "track_genre_cache.rds"
)
View(track_genre_cache)
